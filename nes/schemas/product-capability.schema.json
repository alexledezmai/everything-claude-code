{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nes.dev/schemas/product-capability.schema.json",
  "title": "NES Product Capability",
  "type": "object",
  "required": ["id", "name", "status", "description", "source_paths"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["planned", "in_progress", "verified", "production"] },
    "description": { "type": "string", "minLength": 1 },
    "source_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "gate_ids": { "type": "array", "items": { "type": "string" } },
    "adr_ids": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
