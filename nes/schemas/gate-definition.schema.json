{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nes.dev/schemas/gate-definition.schema.json",
  "title": "NES Gate Definition",
  "type": "object",
  "required": ["id", "checks"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["capability", "regression", "architecture", "security", "production"]
    },
    "description": { "type": "string" },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "oneOf": [
            { "const": "all" },
            { "type": "integer", "minimum": 1 }
          ]
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "op": {
            "type": "string",
            "enum": ["eq", "truthy", "gte", "lte", "exists", "preserve", "gte-baseline", "lte-baseline"]
          },
          "expected": {}
        }
      }
    }
  }
}
