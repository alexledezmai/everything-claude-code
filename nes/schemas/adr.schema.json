{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nes.dev/schemas/adr.schema.json",
  "title": "NES Architecture Decision Record",
  "type": "object",
  "required": ["id", "title", "status", "context", "decision", "consequences"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^ADR-[0-9]{3,}$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["proposed", "accepted", "superseded", "deprecated"] },
    "context": { "type": "string", "minLength": 1 },
    "decision": { "type": "string", "minLength": 1 },
    "consequences": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "alternatives": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "supersedes": { "type": "string" }
  }
}
